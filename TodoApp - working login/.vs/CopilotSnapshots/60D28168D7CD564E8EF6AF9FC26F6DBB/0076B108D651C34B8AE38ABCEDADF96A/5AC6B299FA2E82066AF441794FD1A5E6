<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TodoApp.Views"
    xmlns:pages="clr-namespace:ToDoApp.MAUI.pages"
    x:Class="TodoApp.AppShell">
    <TabBar>

        <ShellContent
            Title="ToDo"
            ContentTemplate="{DataTemplate views:TodoPage}" />

        <ShellContent
            Title="Completed"
            ContentTemplate="{DataTemplate views:CompletedPage}" />

        <ShellContent
            Title="Profile"
            ContentTemplate="{DataTemplate views:ProfilePage}" />

        <ShellContent
            Title="Sign In"
            ContentTemplate="{DataTemplate views:SignInView}" 
            Route="SignIn" />
        
        <ShellContent
             Title="Sign Up"
             ContentTemplate="{DataTemplate views:SignUpView}"
             Route="SignUp" />

    </TabBar>

</Shell>