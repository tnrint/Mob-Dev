<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TodoApp.Views.pages.SignInView"
             Title="SignIn">
    <VerticalStackLayout>
        <Label 
            Text="Sign In"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        
        <Entry Text="{Binding Email}" />
        <Entry IsPassword="True" Text="{Binding Password}" />
        <Button Command="{Binding SignInCommand}" Text="Sign In" />
        <Button Command="{Binding NavigateToSignUpCommand}" Text="Don't have an account? Sign Up" />



    </VerticalStackLayout>
</ContentPage>