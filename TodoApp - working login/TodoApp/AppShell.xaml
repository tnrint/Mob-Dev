<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TodoApp.Views"
    xmlns:pages="clr-namespace:TodoApp.Views.pages"
    x:Class="TodoApp.AppShell">
    <!-- Authentication pages are defined as routes (not tabs) so they don't appear in the main TabBar -->
    <ShellContent Route="SignIn" ContentTemplate="{DataTemplate pages:SignInView}" />
    <ShellContent Route="SignUp" ContentTemplate="{DataTemplate pages:SignUpView}" />

    <TabBar>
        <ShellContent
            Title="ToDo"
            Route="Todo"
            ContentTemplate="{DataTemplate views:TodoPage}" />

        <ShellContent
            Title="Completed"
            Route="Completed"
            ContentTemplate="{DataTemplate views:CompletedPage}" />

        <ShellContent
            Title="Profile"
            Route="Profile"
            ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>

</Shell>