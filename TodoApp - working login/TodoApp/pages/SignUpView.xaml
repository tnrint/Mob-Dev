<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TodoApp.Views.pages.SignUpView"
             Title="Sign Up">
    <VerticalStackLayout Padding="24" Spacing="18" VerticalOptions="Center">
        <Label
            Text="Create account"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Frame HasShadow="True" CornerRadius="8" Padding="12">
            <VerticalStackLayout Spacing="12">
                <Entry Placeholder="Username" Text="{Binding Username}" />
                <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
                <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />
                <Button Command="{Binding SignUpCommand}" Text="Sign Up" BackgroundColor="#2E86AB" TextColor="White" />
            </VerticalStackLayout>
        </Frame>

        <Button Command="{Binding NavigateToSignInCommand}" Text="Already have an account? Sign in" BackgroundColor="Transparent" TextColor="#2E86AB" />
    </VerticalStackLayout>
</ContentPage>